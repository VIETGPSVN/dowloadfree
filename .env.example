# Sao chép thành .env rồi điền giá trị thật. Chạy Docker: docker run --env-file .env ...

# Thông tin hiển thị trên website và các trang pháp lý
SITE_NAME=TaiVideo
CONTACT_EMAIL=lienhe@tenmiencuaban.com
LEGAL_UPDATED=25/11/2026

# Cloudflare Turnstile (lấy tại dash.cloudflare.com > Turnstile > Add widget)
# Để trống = tắt CAPTCHA (chỉ nên dùng khi chạy thử trên máy)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Giới hạn (tuỳ chọn)
MAX_MB=200
MAX_DURATION=900
RATE_LIMIT=10
RATE_WINDOW=600
MAX_CONCURRENT=2

# Gợi ý khi chạy gói miễn phí (tài nguyên nhỏ): giảm tải để đỡ bị treo/khoá
# MAX_MB=100
# MAX_DURATION=300
# MAX_CONCURRENT=1
